{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-clone-worker1",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-clone-worker-db","database_id": "0350613d-3788-46b6-82a8-9f013ead0d9c"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
